{
  "name": "Retail Profitability & Customer Analytics — Clean Enterprise",
  "dataColors": [
    "#4776A8",
    "#168A83",
    "#23395B",
    "#64748B",
    "#8FA8C8",
    "#6FB7B0",
    "#AAB6C5",
    "#D6A85F"
  ],
  "background": "#F4F6F9",
  "foreground": "#23395B",
  "tableAccent": "#4776A8",
  "good": "#168A83",
  "neutral": "#64748B",
  "bad": "#C65D5D",
  "visualStyles": {
    "*": {
