        "title": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 13,
            "fontColor": {
              "solid": {
                "color": "#23395B"
              }
            },
            "bold": true,
            "alignment": "left"
          }
        ],
        "labels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#64748B"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "labelFontFamily": "Segoe UI",
            "labelFontSize": 10,
            "gridlineColor": {
              "solid": {
                "color": "#DCE2EA"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "labelFontFamily": "Segoe UI",
            "labelFontSize": 10,
            "gridlineColor": {
              "solid": {
                "color": "#DCE2EA"
              }
            }
